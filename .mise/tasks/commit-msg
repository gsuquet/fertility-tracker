#!/usr/bin/env bash
#MISE description="Check that a commit message follows Conventional Commits"
#USAGE arg "[file]" help="File with the commit message. Without it, the task reads the standard input."
set -euo pipefail
node --input-type=module -e "
import { readFileSync } from 'node:fs';
import { main } from './scripts/commits/checkCommitMessage.ts';
const args = process.argv.slice(1);
process.exit(main(args, args.length === 0 ? readFileSync(0, 'utf8') : ''));
" "$@"
