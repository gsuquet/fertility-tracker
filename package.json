{
  "name": "fertility-tracker",
  "version": "1.16.0",
  "private": true,
  "description": "Offline-first Creighton Model (CrMS) fertility cycle charting app.",
  "type": "module",
  "license": "MIT",
  "author": "gsuquet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gsuquet/fertility-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/gsuquet/fertility-tracker/issues"
  },
  "homepage": "https://github.com/gsuquet/fertility-tracker#readme",
  "keywords": [],
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "26.12.1",
    "npm": "11.20.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.20.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --error-on-warnings .",
    "check:fix": "biome check --write .",
    "validate": "npm run check && npm run typecheck && npm run test:coverage && vite build"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.153.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
