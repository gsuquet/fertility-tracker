  },
  "homepage": "https://github.com/gsuquet/fertility-tracker#readme",
  "dependencies": {
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@testing-library/dom": "^10.4.1",
